<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="40dp"
            android:paddingRight="24dp"
            android:paddingBottom="56dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚 Calculadora de Notas"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Digite suas notas e veja o resultado na hora"
                android:textColor="#D6E2FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card de notas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="-36dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Suas notas"
                android:textColor="#1F3B64"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Prova -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📝  Prova"
                    android:textColor="#22304A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="0 a 10"
                    android:textColor="#3F6FD8"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editProva"
                style="@style/CampoNota"
                android:hint="ex.: 9,03"
                android:imeOptions="actionNext" />

            <!-- Trabalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📂  Trabalho"
                    android:textColor="#22304A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="0 a 4"
                    android:textColor="#3F6FD8"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editTrabalho"
                style="@style/CampoNota"
                android:layout_marginBottom="4dp"
                android:hint="ex.: 3,93"
                android:imeOptions="actionNext" />

            <TextView
                android:id="@+id/txtTrabalhoConvertido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Convertido para 0 a 10: —"
                android:textColor="#5A6B85"
                android:textSize="13sp" />

            <!-- Formativa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐  Avaliação Formativa"
                    android:textColor="#22304A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingLeft="8dp"
                    android:paddingTop="2dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="2dp"
                    android:text="0 a 10"
                    android:textColor="#3F6FD8"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/editFormativa"
                style="@style/CampoNota"
                android:layout_marginBottom="0dp"
                android:hint="ex.: 9,50"
                android:imeOptions="actionDone" />
        </LinearLayout>

        <!-- Card de resultado -->
        <LinearLayout
            android:id="@+id/cardResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_result"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtConceito"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_concept"
                android:gravity="center"
                android:text="?"
                android:textColor="#5A6B85"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtRotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTA FINAL"
                    android:textColor="#5A6B85"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtNotaFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#22304A"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSituacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preencha as três notas"
                    android:textColor="#22304A"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card de detalhes do cálculo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Como foi calculado"
                android:textColor="#1F3B64"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalhes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="((Prova + Trabalho) ÷ 2 × 0,70)\n+ (Formativa × 0,30)"
                android:textColor="#22304A"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="A: 9 – 10   •   B: 8 – 8,9   •   C: 6 – 7,9   •   D: 0 – 5,9\nAprovação: conceito A, B ou C e 75% de frequência."
                android:textColor="#5A6B85"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
